digraph BandSplitVAE {
  graph [fontname="Helvetica", fontsize=12, labelloc="t", label="BandSplitVAE Architecture"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=10];
  rankdir=LR;
  nodesep=0.8;

  Input [label="Input\nLip Landmarks", fillcolor="#EDF2FA"];
  Filter [label="1) Butterworth Filter Bank\n(orders split LF/BP/HF)", fillcolor="#FFEACF"];

  Input -> Filter;

  LFEncoder [label="LF Encoder\n1×1 Conv → TCN → (μ_LF, logσ²_LF)", fillcolor="#DCEBFF", color="#4A7FE7"];
  BPEncoder [label="BP Encoder\nsame pipeline → (μ_BP, logσ²_BP)", fillcolor="#FFE7D3", color="#E69245"];
  HFEncoder [label="HF Encoder\nsame pipeline → (μ_HF, logσ²_HF)", fillcolor="#FFE1F0", color="#D455A7"];

  LFLatent [label="LF Latent z_LF\nμ_LF + σ_LF ⊙ ε", fillcolor="#DCEBFF", color="#4A7FE7"];
  BPLatent [label="BP Latent z_BP\nμ_BP + σ_BP ⊙ ε", fillcolor="#FFE7D3", color="#E69245"];
  HFLatent [label="HF Latent z_HF\nμ_HF + σ_HF ⊙ ε", fillcolor="#FFE1F0", color="#D455A7"];

  LFDecoder [label="LF Decoder\nTCN → x̂_LF", fillcolor="#DCEBFF", color="#4A7FE7"];
  BPDecoder [label="BP Decoder\nTCN → x̂_BP", fillcolor="#FFE7D3", color="#E69245"];
  HFDecoder [label="HF Decoder\nTCN → x̂_HF", fillcolor="#FFE1F0", color="#D455A7"];

  Loss_LF [label="LF Rec Loss + β_LF·KL", fillcolor="#DCEBFF", color="#4A7FE7"];
  Loss_BP [label="BP Rec Loss + β_BP·KL", fillcolor="#FFE7D3", color="#E69245"];
  Loss_HF [label="HF Rec Loss + β_HF·KL", fillcolor="#FFE1F0", color="#D455A7"];
  Loss [label="Total Reconstruction Loss\nΣ_b Loss_b", fillcolor="#FFD7D1"];

  subgraph cluster_latent {
    label="2) Latent Spaces";
    style="rounded,dashed";
    color="#9CA7B8";
    LFLatent;
    BPLatent;
    HFLatent;
  }

  subgraph cluster_rec_loss {
    label="1) Rec loss";
    style="rounded,dashed";
    color="#9CA7B8";
    Loss_LF;
    Loss_BP;
    Loss_HF;
  }

  Filter -> LFEncoder [label="LF split", color="#4A7FE7", fontcolor="#4A7FE7"];
  Filter -> BPEncoder [label="BP split", color="#E69245", fontcolor="#E69245"];
  Filter -> HFEncoder [label="HF split", color="#D455A7", fontcolor="#D455A7"];

  LFEncoder -> LFLatent [color="#4A7FE7"];
  LFLatent -> LFDecoder [color="#4A7FE7"];
  LFDecoder -> Loss_LF [color="#4A7FE7"];

  BPEncoder -> BPLatent [color="#E69245"];
  BPLatent -> BPDecoder [color="#E69245"];
  BPDecoder -> Loss_BP [color="#E69245"];

  HFEncoder -> HFLatent [color="#D455A7"];
  HFLatent -> HFDecoder [color="#D455A7"];
  HFDecoder -> Loss_HF [color="#D455A7"];

  Loss_LF -> Loss;
  Loss_BP -> Loss;
  Loss_HF -> Loss;
}
